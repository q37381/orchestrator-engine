<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  process_definition: 一表多版本(定义不可变)。
  find 合并了原 find / findLatestPublished: version=null 即"取 status 口径下的最新版"(status 也 null 回落 published)。
  注: 本表 status 是发布态(DefinitionStatus 枚举), 与实例运行态 Status 语义不同但持久化口径一致(小写);
  入参是枚举, SQL 经 #{status.status} 取其小写规范值(不注册 TypeHandler)。
-->
<mapper namespace="com.tesla.ities.process.mapper.ProcessDefinitionMapper">

    <resultMap id="BaseResultMap" type="com.tesla.ities.process.domain.ProcessDefinitionEntity">
        <id     property="autoId"        column="auto_id"/>
        <id     property="processDefId"  column="process_def_id"/>
        <result property="version"       column="version"/>
        <result property="name"          column="name"/>
        <result property="definition"    column="definition"/>
        <result property="status"        column="status"/>
        <result property="createdAt"     column="created_at"/>
        <result property="createdBy"     column="created_by"/>
        <result property="creatorId"     column="creator_id"/>
        <result property="updatorId"     column="updator_id"/>
    </resultMap>

    <sql id="columns">
        auto_id, process_def_id, version, name, definition, status, created_at, created_by,
        creator_id, updator_id
    </sql>

    <!-- version 非 null 走唯一键精确定位; 否则按发布态取最新: 显式传 DefinitionStatus 取其小写规范值,
         null 回落到 published 字面量(缺省口径, 与原 findLatestPublished 语义一致) -->
    <select id="find" resultMap="BaseResultMap">
        SELECT <include refid="columns"/>
        FROM ${orch.table.processDefinition}
        WHERE process_def_id = #{defId}
        <choose>
            <when test="version != null">AND version = #{version}</when>
            <when test="status != null">AND status = #{status.status} ORDER BY version DESC LIMIT 1</when>
            <otherwise>AND status = 'published' ORDER BY version DESC LIMIT 1</otherwise>
        </choose>
    </select>

    <insert id="insert" parameterType="com.tesla.ities.process.domain.ProcessDefinitionEntity">
        INSERT INTO ${orch.table.processDefinition}(process_def_id, version, name, definition, status, created_by, creator_id, updator_id)
        VALUES(#{processDefId}, #{version}, #{name}, #{definition}, #{status}, #{createdBy}, #{creatorId}, #{updatorId})
    </insert>

</mapper>
